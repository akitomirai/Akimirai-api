server {
    listen 80;
    listen [::]:80;
    server_name {{PRIMARY_DOMAIN}} {{PRIMARY_WWW_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 308 https://{{PRIMARY_DOMAIN}}$request_uri;
    }
}
