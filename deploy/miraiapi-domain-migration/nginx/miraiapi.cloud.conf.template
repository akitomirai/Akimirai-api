server {
    listen 80;
    listen [::]:80;
    server_name {{PRIMARY_DOMAIN}} {{PRIMARY_WWW_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 308 https://{{PRIMARY_DOMAIN}}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{PRIMARY_DOMAIN}} {{PRIMARY_WWW_DOMAIN}};

    client_max_body_size 256m;

    ssl_certificate /etc/letsencrypt/live/{{PRIMARY_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{PRIMARY_DOMAIN}}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/cloudflare-real-ip.conf;

    location ~ /\. {
        return 404;
    }

    location /assets/ {
        include /etc/nginx/snippets/miraiapi-proxy.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /rent-ledger {
        return 308 https://{{PRIMARY_DOMAIN}}/rent-ledger/;
    }

    location ^~ /rent-ledger/ {
        root /var/www;
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
        types {
            application/json json;
            application/vnd.android.package-archive apk;
        }
    }

    location = /ui-hotfix-20260710.js {
        alias /var/www/akimirai-hotfix/ui-hotfix-20260710.js;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
    }

    location / {
        include /etc/nginx/snippets/miraiapi-proxy.conf;
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</head>' '<script src="/ui-hotfix-20260710.js?v=2"></script></head>';
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        text/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml;
}
