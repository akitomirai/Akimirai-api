server {
    listen 80;
    listen [::]:80;
    server_name {{LEGACY_DOMAIN}} {{LEGACY_WWW_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{LEGACY_DOMAIN}} {{LEGACY_WWW_DOMAIN}};

    client_max_body_size 256m;

    ssl_certificate /etc/letsencrypt/live/{{LEGACY_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{LEGACY_DOMAIN}}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/cloudflare-real-ip.conf;

    location ~ ^/(?:v1|v1beta|backend-api|antigravity|api|setup)(?:/|$) {
        include /etc/nginx/snippets/miraiapi-proxy.conf;
        include /etc/nginx/snippets/miraiapi-legacy-headers.conf;
    }

    location ~ ^/(?:responses|videos)(?:/|$) {
        include /etc/nginx/snippets/miraiapi-proxy.conf;
        include /etc/nginx/snippets/miraiapi-legacy-headers.conf;
    }

    location ~ ^/(?:chat/completions|embeddings|alpha/search|images/(?:generations|edits))/?$ {
        include /etc/nginx/snippets/miraiapi-proxy.conf;
        include /etc/nginx/snippets/miraiapi-legacy-headers.conf;
    }

    location = /health {
        include /etc/nginx/snippets/miraiapi-proxy.conf;
        include /etc/nginx/snippets/miraiapi-legacy-headers.conf;
    }

    location = /rent-ledger {
        include /etc/nginx/snippets/miraiapi-legacy-headers.conf;
        return 308 https://$host/rent-ledger/;
    }

    location ^~ /rent-ledger/ {
        root /var/www;
        try_files $uri =404;
        include /etc/nginx/snippets/miraiapi-legacy-headers.conf;
        add_header Cache-Control "no-store" always;
        types {
            application/json json;
            application/vnd.android.package-archive apk;
        }
    }

    location / {
        return 308 https://{{PRIMARY_DOMAIN}}$request_uri;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        text/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml;
}
